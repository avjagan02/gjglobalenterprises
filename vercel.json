{
  "name": "gj-global-enterprises",
  "version": 2,
  "public": true,
  "buildCommand": "echo 'No build needed for static site'",
  "outputDirectory": "./",
  "framework": "static",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/products", "destination": "/trade#products", "permanent": true },
    { "source": "/scm",      "destination": "/services#scm",   "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*).css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    },
    {
      "source": "/(.*).js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    },
    {
      "source": "/(Gallery|picture|logo)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
